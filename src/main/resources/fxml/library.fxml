<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"
            prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.screen.LibraryController">
    <center>
        <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0">
            <center>
                <SplitPane fx:id="librarySplitPane" dividerPositions="0.2559, 0.8" maxHeight="1.7976931348623157E308"
                           maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"
                           BorderPane.alignment="CENTER">
                    <items>
                        <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0"
                                    minWidth="0.0">
                            <top>
                                <VBox spacing="4.0">
                                    <padding>
                                        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0"/>
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                                            <children>
                                                <TextField fx:id="searchField" promptText="Search artists (Ctrl+F)"
                                                           HBox.hgrow="ALWAYS"/>
                                                <Button mnemonicParsing="false" onAction="#onClearSearch">
                                                    <graphic>
                                                        <FontIcon iconLiteral="mdi2c-close" iconSize="14"/>
                                                    </graphic>
                                                    <tooltip>
                                                        <Tooltip text="Clear the search (Esc)"/>
                                                    </tooltip>
                                                </Button>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </top>
                            <center>
                                <ListView fx:id="artistListView" maxHeight="1.7976931348623157E308"
                                          maxWidth="1.7976931348623157E308" styleClass="artist-list"/>
                            </center>
                            <right>
                                <VBox fx:id="letterStrip" alignment="CENTER" prefWidth="18.0"
                                      styleClass="letter-strip"/>
                            </right>
                        </BorderPane>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="334.0" prefWidth="314.0">
                            <children>
                                <TabPane fx:id="tabPane" maxHeight="1.7976931348623157E308"
                                         maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"
                                         tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0"
                                         AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                                         AnchorPane.topAnchor="0.0">
                                    <tabs>
                                        <Tab fx:id="albumsTab" closable="false"
                                             onSelectionChanged="#onTabSelectionChange" text="Albums">
                                            <content>
                                                <BorderPane>
                                                    <top>
                                                        <HBox alignment="CENTER_LEFT" spacing="8.0"
                                                              styleClass="albums-toolbar">
                                                            <padding>
                                                                <Insets bottom="4.0" left="10.0" right="10.0"
                                                                        top="6.0"/>
                                                            </padding>
                                                            <children>
                                                                <ToggleButton fx:id="albumsListToggle"
                                                                              mnemonicParsing="false" text="List">
                                                                    <graphic>
                                                                        <FontIcon iconLiteral="mdi2v-view-list"
                                                                                  iconSize="16"/>
                                                                    </graphic>
                                                                    <tooltip>
                                                                        <Tooltip
                                                                                text="Albums as a list with track lists"/>
                                                                    </tooltip>
                                                                </ToggleButton>
                                                                <ToggleButton fx:id="albumsGridToggle"
                                                                              mnemonicParsing="false" text="Grid">
                                                                    <graphic>
                                                                        <FontIcon iconLiteral="mdi2v-view-grid"
                                                                                  iconSize="16"/>
                                                                    </graphic>
                                                                    <tooltip>
                                                                        <Tooltip
                                                                                text="Albums as a grid of covers (click to open, double-click to play)"/>
                                                                    </tooltip>
                                                                </ToggleButton>
                                                                <Label styleClass="dim-text" text="Cover size"/>
                                                                <Slider fx:id="albumCoverSizeSlider" max="350.0"
                                                                        min="120.0" prefWidth="160.0" value="350.0"/>
                                                                <Label styleClass="dim-text" text="Sort"/>
                                                                <ComboBox fx:id="albumSortBox"/>
                                                            </children>
                                                        </HBox>
                                                    </top>
                                                    <center>
                                                        <ScrollPane fx:id="albumsScroll" fitToHeight="true"
                                                                    fitToWidth="true" maxHeight="1.7976931348623157E308"
                                                                    maxWidth="1.7976931348623157E308">
                                                            <content>
                                                                <VBox fx:id="artistAlbumsView"
                                                                      maxHeight="1.7976931348623157E308"
                                                                      maxWidth="1.7976931348623157E308" spacing="10.0">
                                                                    <padding>
                                                                        <Insets bottom="10.0" left="10.0" right="10.0"
                                                                                top="10.0"/>
                                                                    </padding>
                                                                    <children>
                                                                        <Label fx:id="artistTitle"
                                                                               maxHeight="1.7976931348623157E308"
                                                                               maxWidth="1.7976931348623157E308"
                                                                               styleClass="text-title">
                                                                        </Label>
                                                                    </children>
                                                                </VBox>
                                                            </content>
                                                        </ScrollPane>
                                                    </center>
                                                </BorderPane>
                                            </content>
                                        </Tab>
                                        <Tab fx:id="currentLyricsTab" onSelectionChanged="#onTabSelectionChange"
                                             text="Current Lyrics"/>
                                        <Tab fx:id="editTagsTab" closable="false"
                                             onSelectionChanged="#onTabSelectionChange" text="Edit Tags"/>
                                        <Tab fx:id="historyTab" closable="false"
                                             onSelectionChanged="#onTabSelectionChange" text="History">
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </children>
                        </AnchorPane>
                        <AnchorPane fx:id="playlistAnchorPane" maxHeight="1.7976931348623157E308"
                                    maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"/>
                    </items>
                </SplitPane>
            </center>
        </BorderPane>
    </center>
    <bottom>
        <VBox>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="transport-bar">
                    <padding>
                        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0"/>
                    </padding>
                    <children>
                        <HBox fx:id="nowPlayingBlock" alignment="CENTER_LEFT" maxWidth="360.0" minWidth="240.0"
                              onMouseClicked="#onNowPlayingBlockClicked" prefWidth="320.0" spacing="10.0"
                              styleClass="transport-now-playing">
                            <children>
                                <ImageView fx:id="currentTrackAlbumImage" fitHeight="56.0" fitWidth="56.0"
                                           pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@/img/noimage.png"/>
                                    </image>
                                </ImageView>
                                <VBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="2.0"
                                      HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="currentTrackName" maxWidth="1.7976931348623157E308"
                                               styleClass="transport-title" text="Nothing playing"/>
                                        <HBox spacing="4.0">
                                            <children>
                                                <Label fx:id="currentTrackArtist" styleClass="transport-subtitle"/>
                                                <Label fx:id="trackSubtitleSeparator" managed="false"
                                                       styleClass="transport-subtitle" text="—" visible="false"/>
                                                <Label fx:id="currentTrackAlbum" styleClass="transport-subtitle"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <VBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="4.0" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Button fx:id="buttonPlayPause" minWidth="52.0" mnemonicParsing="false"
                                                onAction="#onPlayPauseClick" prefWidth="52.0">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2p-play" iconSize="22"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="Play / Pause (Space)"/>
                                            </tooltip>
                                        </Button>
                                        <Button fx:id="buttonNext" disable="true" mnemonicParsing="false"
                                                onAction="#onNextClick">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2s-skip-next" iconSize="22"/>
                                            </graphic>
                                            <tooltip>
                                                <Tooltip text="Next track"/>
                                            </tooltip>
                                        </Button>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <Label fx:id="timeSinceStart" alignment="CENTER_RIGHT" minWidth="56.0"
                                               prefWidth="56.0" styleClass="transport-time" text="0:00"/>
                                        <StackPane fx:id="canvasPane" maxHeight="56.0" maxWidth="1.7976931348623157E308"
                                                   minHeight="56.0" minWidth="100.0" prefHeight="56.0"
                                                   HBox.hgrow="ALWAYS">
                                            <children>
                                                <Canvas fx:id="currentTrackProgress" height="56.0"
                                                        onMouseClicked="#onProgressClicked" width="600.0"/>
                                            </children>
                                        </StackPane>
                                        <Label fx:id="timeRemaining" minWidth="56.0" prefWidth="56.0"
                                               styleClass="transport-time" text="-0:00"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                            <children>
                                <Label fx:id="volumeIcon" onMouseClicked="#onVolumeIconClicked"
                                       styleClass="transport-volume-icon">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2v-volume-high" iconSize="20"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Click to mute / unmute"/>
                                    </tooltip>
                                </Label>
                                <Slider fx:id="volumeControl" blockIncrement="1.0" prefWidth="110.0" value="30.0"/>
                                <Button fx:id="buttonPlaybackWindow" disable="true" mnemonicParsing="false"
                                        onAction="#onPlaybackWindowClick" text="Now Playing">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2m-music-note" iconSize="16"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Open the playback window"/>
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
                    <padding>
                        <Insets bottom="4.0" left="10.0" right="10.0" top="4.0"/>
                    </padding>
                    <children>
                        <Label fx:id="taskLabel" managed="false" visible="false"/>
                        <ProgressBar fx:id="taskProgress" managed="false" prefWidth="220.0" visible="false"/>
                        <Button fx:id="taskCancelButton" managed="false" mnemonicParsing="false"
                                onAction="#onCancelBackgroundTask" text="Cancel" visible="false">
                            <tooltip>
                                <Tooltip text="Stop the running task"/>
                            </tooltip>
                        </Button>
                        <Label fx:id="toastLabel" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308"
                               HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onRescanMenuClicked" text="Rescan library..."/>
                        <MenuItem mnemonicParsing="false" onAction="#onSettingsMenuClicked" text="Settings..."/>
                        <MenuItem mnemonicParsing="false" onAction="#onCloseMenuClicked" text="Close"/>
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onAboutMenuClicked" text="About"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
</BorderPane>
