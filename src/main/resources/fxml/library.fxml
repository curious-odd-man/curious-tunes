<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"
            prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.screen.LibraryController">
    <center>
        <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0">
            <top>
                <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0"
                            minWidth="0.0" BorderPane.alignment="CENTER">
                    <left>
                        <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
                            <children>
                                <Button fx:id="buttonPlayPause" mnemonicParsing="false" onAction="#onPlayPauseClick"
                                        text=" ▶ ">
                                    <font>
                                        <Font size="18.0"/>
                                    </font>
                                    <tooltip>
                                        <Tooltip text="Play / Pause (Space)"/>
                                    </tooltip>
                                </Button>
                                <Button fx:id="buttonPlaybackWindow" disable="true" mnemonicParsing="false"
                                        onAction="#onPlaybackWindowClick" text="🎵 Now Playing">
                                    <font>
                                        <Font size="14.0"/>
                                    </font>
                                    <tooltip>
                                        <Tooltip text="Open the playback window"/>
                                    </tooltip>
                                </Button>
                                <Slider fx:id="volumeControl" blockIncrement="1.0" majorTickUnit="20.0"
                                        minorTickCount="2" showTickLabels="true" showTickMarks="true" value="30.0">
                                    <tooltip>
                                        <Tooltip text="Volume"/>
                                    </tooltip>
                                </Slider>
                            </children>
                            <BorderPane.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </BorderPane.margin>
                        </HBox>
                    </left>
                    <center>
                        <BorderPane BorderPane.alignment="CENTER">
                            <BorderPane.margin>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                            </BorderPane.margin>
                            <center>
                                <HBox alignment="CENTER" maxHeight="1.7976931348623157E308"
                                      maxWidth="1.7976931348623157E308" spacing="10.0">
                                    <children>
                                        <ImageView fx:id="currentTrackAlbumImage" fitHeight="50.0" fitWidth="50.0"
                                                   pickOnBounds="true" preserveRatio="true"/>
                                        <Label fx:id="currentTrackName" maxHeight="1.7976931348623157E308"
                                               maxWidth="1.7976931348623157E308">
                                            <font>
                                                <Font name="Consolas Bold" size="17.0"/>
                                            </font>
                                        </Label>
                                        <Label text="-">
                                            <font>
                                                <Font size="17.0"/>
                                            </font>
                                        </Label>
                                        <Label fx:id="currentTrackAlbum" maxHeight="1.7976931348623157E308"
                                               maxWidth="1.7976931348623157E308">
                                            <font>
                                                <Font name="Consolas Bold" size="17.0"/>
                                            </font>
                                        </Label>
                                        <Label layoutX="708.0" layoutY="22.0" text="-">
                                            <font>
                                                <Font size="17.0"/>
                                            </font>
                                        </Label>
                                        <Label fx:id="currentTrackArtist" maxHeight="1.7976931348623157E308"
                                               maxWidth="1.7976931348623157E308">
                                            <font>
                                                <Font name="Consolas Bold" size="17.0"/>
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </center>
                            <left>
                                <Label fx:id="timeSinceStart" alignment="BOTTOM_LEFT" maxHeight="1.7976931348623157E308"
                                       maxWidth="1.7976931348623157E308" BorderPane.alignment="BOTTOM_LEFT">
                                    <font>
                                        <Font size="24.0"/>
                                    </font>
                                </Label>
                            </left>
                            <right>
                                <Label fx:id="timeRemaining" maxHeight="1.7976931348623157E308"
                                       maxWidth="1.7976931348623157E308" BorderPane.alignment="BOTTOM_RIGHT">
                                    <font>
                                        <Font size="24.0"/>
                                    </font>
                                </Label>
                            </right>
                        </BorderPane>
                    </center>
                    <bottom>
                        <StackPane fx:id="canvasPane" maxHeight="1.7976931348623157E308"
                                   maxWidth="1.7976931348623157E308" minHeight="100.0" minWidth="100.0">
                            <children>
                                <Canvas fx:id="currentTrackProgress" height="100.0" onMouseClicked="#onProgressClicked"
                                        width="1920.0"/>
                            </children>
                        </StackPane>
                    </bottom>
                </BorderPane>
            </top>
            <center>
                <SplitPane fx:id="librarySplitPane" dividerPositions="0.2559, 0.8" maxHeight="1.7976931348623157E308"
                           maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"
                           BorderPane.alignment="CENTER">
                    <items>
                        <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0"
                                    minWidth="0.0">
                            <top>
                                <VBox spacing="4.0">
                                    <padding>
                                        <Insets bottom="6.0" left="6.0" right="6.0" top="6.0"/>
                                    </padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="4.0">
                                            <children>
                                                <TextField fx:id="searchField" promptText="Search artists (Ctrl+F)"
                                                           HBox.hgrow="ALWAYS"/>
                                                <Button mnemonicParsing="false" onAction="#onClearSearch" text="✕">
                                                    <tooltip>
                                                        <Tooltip text="Clear the search (Esc)"/>
                                                    </tooltip>
                                                </Button>
                                            </children>
                                        </HBox>
                                        <Label fx:id="noArtistsLabel" managed="false" styleClass="dim-text"
                                               text="No artists match" visible="false"/>
                                    </children>
                                </VBox>
                            </top>
                            <center>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308"
                                            maxWidth="1.7976931348623157E308">
                                    <content>
                                        <VBox fx:id="artistList" alignment="CENTER" maxHeight="1.7976931348623157E308"
                                              maxWidth="1.7976931348623157E308"/>
                                    </content>
                                </ScrollPane>
                            </center>
                        </BorderPane>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="334.0" prefWidth="314.0">
                            <children>
                                <TabPane fx:id="tabPane" maxHeight="1.7976931348623157E308"
                                         maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"
                                         tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0"
                                         AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                                         AnchorPane.topAnchor="0.0">
                                    <tabs>
                                        <Tab fx:id="albumsTab" closable="false"
                                             onSelectionChanged="#onTabSelectionChange" text="Albums">
                                            <content>
                                                <BorderPane>
                                                    <top>
                                                        <HBox alignment="CENTER_LEFT" spacing="8.0"
                                                              styleClass="albums-toolbar">
                                                            <padding>
                                                                <Insets bottom="4.0" left="10.0" right="10.0"
                                                                        top="6.0"/>
                                                            </padding>
                                                            <children>
                                                                <ToggleButton fx:id="albumsListToggle"
                                                                              mnemonicParsing="false" text="☰ List">
                                                                    <tooltip>
                                                                        <Tooltip
                                                                                text="Albums as a list with track lists"/>
                                                                    </tooltip>
                                                                </ToggleButton>
                                                                <ToggleButton fx:id="albumsGridToggle"
                                                                              mnemonicParsing="false" text="▦ Grid">
                                                                    <tooltip>
                                                                        <Tooltip
                                                                                text="Albums as a grid of covers (click to open, double-click to play)"/>
                                                                    </tooltip>
                                                                </ToggleButton>
                                                                <Label styleClass="dim-text" text="Cover size"/>
                                                                <Slider fx:id="albumCoverSizeSlider" max="350.0"
                                                                        min="120.0" prefWidth="160.0" value="350.0"/>
                                                            </children>
                                                        </HBox>
                                                    </top>
                                                    <center>
                                                        <ScrollPane fx:id="albumsScroll" fitToHeight="true"
                                                                    fitToWidth="true" maxHeight="1.7976931348623157E308"
                                                                    maxWidth="1.7976931348623157E308">
                                                            <content>
                                                                <VBox fx:id="artistAlbumsView"
                                                                      maxHeight="1.7976931348623157E308"
                                                                      maxWidth="1.7976931348623157E308" spacing="10.0">
                                                                    <padding>
                                                                        <Insets bottom="10.0" left="10.0" right="10.0"
                                                                                top="10.0"/>
                                                                    </padding>
                                                                    <children>
                                                                        <Label fx:id="artistTitle"
                                                                               maxHeight="1.7976931348623157E308"
                                                                               maxWidth="1.7976931348623157E308">
                                                                            <font>
                                                                                <Font name="System Bold" size="24.0"/>
                                                                            </font>
                                                                        </Label>
                                                                    </children>
                                                                </VBox>
                                                            </content>
                                                        </ScrollPane>
                                                    </center>
                                                </BorderPane>
                                            </content>
                                        </Tab>
                                        <Tab fx:id="currentLyricsTab" onSelectionChanged="#onTabSelectionChange"
                                             text="Current Lyrics"/>
                                        <Tab fx:id="editTagsTab" closable="false"
                                             onSelectionChanged="#onTabSelectionChange" text="Edit Tags"/>
                                        <Tab fx:id="historyTab" closable="false"
                                             onSelectionChanged="#onTabSelectionChange" text="History">
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </children>
                        </AnchorPane>
                        <AnchorPane fx:id="playlistAnchorPane" maxHeight="1.7976931348623157E308"
                                    maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0"/>
                    </items>
                </SplitPane>
            </center>
        </BorderPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
            <padding>
                <Insets bottom="4.0" left="10.0" right="10.0" top="4.0"/>
            </padding>
            <children>
                <Label fx:id="taskLabel" managed="false" visible="false"/>
                <ProgressBar fx:id="taskProgress" managed="false" prefWidth="220.0" visible="false"/>
                <Button fx:id="taskCancelButton" managed="false" mnemonicParsing="false"
                        onAction="#onCancelBackgroundTask" text="Cancel" visible="false">
                    <tooltip>
                        <Tooltip text="Stop the running task"/>
                    </tooltip>
                </Button>
                <Label fx:id="toastLabel" alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308"
                       HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </bottom>
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onRescanMenuClicked" text="Rescan library..."/>
                        <MenuItem mnemonicParsing="false" onAction="#onCloseMenuClicked" text="Close"/>
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#onAboutMenuClicked" text="About"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
</BorderPane>
