<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="167.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.screen.RescanLibraryController">
   <children>
      <TextField fx:id="path" layoutX="22.0" layoutY="35.0" prefHeight="51.0" prefWidth="503.0" />
      <Button layoutX="525.0" layoutY="35.0" mnemonicParsing="false" onAction="#onChoosePath" text="📂">
         <font>
            <Font size="24.0" />
         </font>
         <tooltip>
            <Tooltip text="Choose the music folder..." />
         </tooltip>
      </Button>
      <Label fx:id="errorLabel" layoutX="22.0" layoutY="88.0" text="" textFill="RED" />
      <Button fx:id="scanButton" defaultButton="true" layoutX="200.0" layoutY="105.0" mnemonicParsing="false" onAction="#onRescan" text="🔄 Scan">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <Button cancelButton="true" layoutX="320.0" layoutY="105.0" mnemonicParsing="false" onAction="#onCancel" text="Cancel">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
