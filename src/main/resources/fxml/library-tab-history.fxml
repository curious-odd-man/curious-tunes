<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.element.tabs.LibraryHistoryTabController">
    <padding>
        <Insets bottom="10.0" left="12.0" right="12.0" top="12.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <children>
                <Label styleClass="dim-text" text="Period"/>
                <ToggleButton fx:id="todayToggle" mnemonicParsing="false" text="Today"/>
                <ToggleButton fx:id="weekToggle" mnemonicParsing="false" text="7 days"/>
                <ToggleButton fx:id="monthToggle" mnemonicParsing="false" text="30 days"/>
                <ToggleButton fx:id="allToggle" mnemonicParsing="false" selected="true" text="All time"/>
            </children>
        </HBox>
        <HBox spacing="12.0">
            <children>
                <VBox spacing="2.0" styleClass="stat-card">
                    <children>
                        <Label fx:id="totalTimeListened" styleClass="text-title" text="–"/>
                        <Label styleClass="dim-text" text="Time listened"/>
                    </children>
                </VBox>
                <VBox spacing="2.0" styleClass="stat-card">
                    <children>
                        <Label fx:id="songsPlayed" styleClass="text-title" text="–"/>
                        <Label styleClass="dim-text" text="Songs played"/>
                    </children>
                </VBox>
                <VBox spacing="2.0" styleClass="stat-card">
                    <children>
                        <Label fx:id="albumsPlayed" styleClass="text-title" text="–"/>
                        <Label styleClass="dim-text" text="Albums"/>
                    </children>
                </VBox>
                <VBox spacing="2.0" styleClass="stat-card">
                    <children>
                        <Label fx:id="artistsPlayed" styleClass="text-title" text="–"/>
                        <Label styleClass="dim-text" text="Artists"/>
                    </children>
                </VBox>
            </children>
        </HBox>
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="latestSongsTable" maxHeight="1.7976931348623157E308"
                           maxWidth="1.7976931348623157E308">
                    <columns>
                        <TableColumn fx:id="playedAtColumn" editable="false" maxWidth="170.0" minWidth="120.0"
                                     prefWidth="140.0" text="Played at"/>
                        <TableColumn fx:id="songColumn" editable="false" prefWidth="260.0" text="Song"/>
                        <TableColumn fx:id="artistColumn" editable="false" prefWidth="180.0" text="Artist"/>
                        <TableColumn fx:id="albumColumn" editable="false" prefWidth="180.0" text="Album"/>
                    </columns>
                </TableView>
                <Label fx:id="emptyLabel" managed="false" styleClass="dim-text" visible="false"/>
                <ProgressIndicator fx:id="loadingIndicator" managed="false" maxHeight="40.0" maxWidth="40.0"
                                   visible="false"/>
            </children>
        </StackPane>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="shownLabel" styleClass="dim-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="loadMoreButton" managed="false" mnemonicParsing="false" onAction="#onLoadMore"
                        text="Load more" visible="false"/>
            </children>
        </HBox>
    </children>
</VBox>
