<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox fx:id="rootPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0"
      minWidth="0.0"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.element.tabs.LibraryTagEditTabController">
    <children>
        <Label fx:id="emptyLabel" styleClass="dim-text"
               text="Select a track and choose “Edit tags” in its right-click menu. Select several tracks to change what they share."
               wrapText="true">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
        </Label>
        <VBox fx:id="contentBox" managed="false" spacing="6.0" visible="false" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <padding>
                        <Insets bottom="4.0" left="12.0" right="12.0" top="10.0"/>
                    </padding>
                    <children>
                        <ImageView fx:id="headerCover" fitHeight="56.0" fitWidth="56.0" pickOnBounds="true"
                                   preserveRatio="true">
                            <image>
                                <Image url="@/img/noimage.png"/>
                            </image>
                        </ImageView>
                        <VBox maxWidth="1.7976931348623157E308" spacing="2.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="headerTitle" maxWidth="1.7976931348623157E308" styleClass="text-section"/>
                                <Label fx:id="headerSubtitle" maxWidth="1.7976931348623157E308" styleClass="dim-text"/>
                                <Label fx:id="headerPath" maxWidth="1.7976931348623157E308"
                                       styleClass="dim-text, text-small"/>
                            </children>
                        </VBox>
                        <Button fx:id="saveButton" disable="true" mnemonicParsing="false" onAction="#onSave"
                                text="Save">
                            <graphic>
                                <FontIcon iconLiteral="mdi2c-content-save" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Save the changes (Ctrl+S)"/>
                            </tooltip>
                        </Button>
                        <Button fx:id="revertButton" disable="true" mnemonicParsing="false" onAction="#onRevert"
                                text="Revert">
                            <graphic>
                                <FontIcon iconLiteral="mdi2u-undo" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Throw away the changes that are not saved"/>
                            </tooltip>
                        </Button>
                        <Button fx:id="findLyricsButton" mnemonicParsing="false" onAction="#onFindLyrics"
                                text="Find lyrics">
                            <graphic>
                                <FontIcon iconLiteral="mdi2m-magnify" iconSize="16"/>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <HBox spacing="24.0">
                            <padding>
                                <Insets bottom="10.0" left="12.0" right="12.0" top="8.0"/>
                            </padding>
                            <children>
                                <GridPane fx:id="tagsGrid" hgap="8.0" minWidth="-Infinity" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints halignment="RIGHT" minWidth="110.0" prefWidth="110.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="240.0" prefWidth="300.0"/>
                                        <ColumnConstraints minWidth="34.0" prefWidth="34.0"/>
                                    </columnConstraints>
                                    <children>
                                        <Label text="Artist" GridPane.rowIndex="0"/>
                                        <TextField fx:id="artistField" promptText="Artist" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="0"/>

                                        <Label text="Album" GridPane.rowIndex="1"/>
                                        <TextField fx:id="albumField" promptText="Album" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="1"/>

                                        <Label text="Title" GridPane.rowIndex="2"/>
                                        <TextField fx:id="titleField" promptText="Title" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="2"/>
                                        <Button fx:id="restoreTitleButton" managed="false" mnemonicParsing="false"
                                                visible="false" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                            </graphic>
                                        </Button>

                                        <Label text="Track number" GridPane.rowIndex="3"/>
                                        <TextField fx:id="trackNumberField" promptText="1" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="3"/>
                                        <Button fx:id="restoreTrackNumberButton" managed="false" mnemonicParsing="false"
                                                visible="false" GridPane.columnIndex="2" GridPane.rowIndex="3">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                            </graphic>
                                        </Button>

                                        <Label text="Disc number" GridPane.rowIndex="4"/>
                                        <TextField fx:id="diskNumberField" promptText="1" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="4"/>
                                        <Button fx:id="restoreDiskNumberButton" managed="false" mnemonicParsing="false"
                                                visible="false" GridPane.columnIndex="2" GridPane.rowIndex="4">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                            </graphic>
                                        </Button>

                                        <Label text="Genre" GridPane.rowIndex="5"/>
                                        <TextField fx:id="genreField" promptText="Genre" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="5"/>
                                        <Button fx:id="restoreGenreButton" managed="false" mnemonicParsing="false"
                                                visible="false" GridPane.columnIndex="2" GridPane.rowIndex="5">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                            </graphic>
                                        </Button>

                                        <Label text="Composer" GridPane.rowIndex="6"/>
                                        <TextField fx:id="composerField" promptText="Composer" GridPane.columnIndex="1"
                                                   GridPane.rowIndex="6"/>
                                        <Button fx:id="restoreComposerButton" managed="false" mnemonicParsing="false"
                                                visible="false" GridPane.columnIndex="2" GridPane.rowIndex="6">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                            </graphic>
                                        </Button>

                                        <Label text="Release date" GridPane.rowIndex="7"/>
                                        <TextField fx:id="releaseDateField" promptText="YYYY or YYYY-MM-DD"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                                        <Button fx:id="restoreReleaseDateButton" managed="false" mnemonicParsing="false"
                                                visible="false" GridPane.columnIndex="2" GridPane.rowIndex="7">
                                            <graphic>
                                                <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                            </graphic>
                                        </Button>

                                        <Label text="Cover" GridPane.rowIndex="8" GridPane.valignment="TOP"/>
                                        <HBox fx:id="coverRow" spacing="10.0" GridPane.columnIndex="1"
                                              GridPane.rowIndex="8">
                                            <children>
                                                <StackPane styleClass="cover-box">
                                                    <children>
                                                        <ImageView fx:id="albumCoverImage" fitHeight="100.0"
                                                                   fitWidth="100.0" pickOnBounds="true"
                                                                   preserveRatio="true">
                                                            <image>
                                                                <Image url="@/img/noimage.png"/>
                                                            </image>
                                                        </ImageView>
                                                    </children>
                                                </StackPane>
                                                <VBox spacing="6.0">
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#onChooseCover"
                                                                text="Choose…"/>
                                                        <Button mnemonicParsing="false" onAction="#onPasteCover"
                                                                text="Paste">
                                                            <tooltip>
                                                                <Tooltip
                                                                        text="Use the image (or image file) from the clipboard"/>
                                                            </tooltip>
                                                        </Button>
                                                        <Label styleClass="dim-text, text-small"
                                                               text="Or drop an image here.&#10;Applies to the whole album."/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>
                                <VBox maxWidth="1.7976931348623157E308" spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label text="Lyrics"/>
                                                <Button fx:id="restoreLyricsButton" managed="false"
                                                        mnemonicParsing="false" visible="false">
                                                    <graphic>
                                                        <FontIcon iconLiteral="mdi2u-undo" iconSize="14"/>
                                                    </graphic>
                                                </Button>
                                            </children>
                                        </HBox>
                                        <TextArea fx:id="lyricsEditArea" minHeight="260.0" prefRowCount="14"
                                                  wrapText="true" VBox.vgrow="ALWAYS"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </ScrollPane>
                <Label fx:id="legendLabel" styleClass="dim-text, text-small" wrapText="true">
                    <padding>
                        <Insets bottom="8.0" left="12.0" right="12.0" top="2.0"/>
                    </padding>
                </Label>
            </children>
        </VBox>
    </children>
</VBox>
