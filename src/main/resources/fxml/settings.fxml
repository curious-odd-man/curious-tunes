<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox minWidth="600.0" prefWidth="680.0" spacing="14.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.screen.SettingsController">
    <padding>
        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/>
    </padding>
    <children>
        <Label styleClass="text-section" text="Settings"/>
        <GridPane hgap="14.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="140.0" prefWidth="140.0"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <children>
                <Label text="Music folder" GridPane.valignment="TOP"/>
                <VBox spacing="4.0" GridPane.columnIndex="1">
                    <children>
                        <HBox spacing="6.0">
                            <children>
                                <TextField fx:id="folderField" maxWidth="1.7976931348623157E308"
                                           promptText="The folder with your music" HBox.hgrow="ALWAYS"/>
                                <Button mnemonicParsing="false" onAction="#onChooseFolder" text="Browse…">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2f-folder-open" iconSize="18"/>
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Choose the music folder"/>
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                        <Label styleClass="dim-text, text-small" text="Offered by File ▸ Rescan library."/>
                    </children>
                </VBox>

                <Label text="Play buttons" GridPane.rowIndex="1" GridPane.valignment="TOP"/>
                <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <RadioButton fx:id="inOrderRadio" mnemonicParsing="false" selected="true" text="Play in order">
                            <toggleGroup>
                                <ToggleGroup fx:id="playModeGroup"/>
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="shuffledRadio" mnemonicParsing="false" text="Play shuffled"
                                     toggleGroup="$playModeGroup"/>
                        <Label styleClass="dim-text, text-small"
                               text="Applies to the play and add buttons of artists and albums. The shuffle buttons always shuffle."
                               wrapText="true"/>
                    </children>
                </VBox>

                <Label text="Lyrics text size" GridPane.rowIndex="2" GridPane.valignment="TOP"/>
                <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Slider fx:id="lyricsSizeSlider" blockIncrement="1.0" majorTickUnit="5.0" max="40.0"
                                        min="10.0" prefWidth="260.0" showTickMarks="true" value="16.0"/>
                                <Label fx:id="lyricsSizeLabel" minWidth="50.0"/>
                            </children>
                        </HBox>
                        <Label fx:id="lyricsPreview" text="The lyrics look like this." wrapText="true"/>
                        <Label styleClass="dim-text, text-small"
                               text="The same size is used in the lyrics tab and in the playback window."/>
                    </children>
                </VBox>
            </children>
        </GridPane>
        <Label fx:id="errorLabel" minHeight="20.0" styleClass="toast-error"/>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <children>
                <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancel" text="Cancel"/>
                <Button defaultButton="true" mnemonicParsing="false" onAction="#onSave" text="Save">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-content-save" iconSize="16"/>
                    </graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
