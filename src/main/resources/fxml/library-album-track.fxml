<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<HBox fx:id="rootHbox" fillHeight="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
      onMouseClicked="#onMouseClicked" spacing="10.0" styleClass="library-album-track"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.element.LibraryArtistAlbumTrackController">
    <children>
        <Label fx:id="warningLabel" text="" styleClass="no-lyrics-hint" visible="false" HBox.hgrow="NEVER">
            <graphic>
                <FontIcon iconLiteral="mdi2m-music-note-off" iconSize="14"/>
            </graphic>
        </Label>
        <Label fx:id="trackNumberLabel" alignment="CENTER_RIGHT" minWidth="28.0" prefWidth="28.0" HBox.hgrow="NEVER"
               styleClass="text-body">
        </Label>
        <Label fx:id="trackTitleLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
               HBox.hgrow="ALWAYS" styleClass="text-body">
        </Label>
        <Label fx:id="trackTimeLabel" alignment="CENTER_RIGHT" maxHeight="1.7976931348623157E308" minWidth="60.0"
               prefWidth="60.0" HBox.hgrow="NEVER" styleClass="text-body">
        </Label>
    </children>
    <padding>
        <Insets left="10.0" right="10.0" top="2.0"/>
    </padding>
</HBox>
