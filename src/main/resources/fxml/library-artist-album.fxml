<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane fx:id="pane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.github.curiousoddman.curious_tunes.ui.controller.element.LibraryArtistAlbumController">
    <left>
        <StackPane onMouseEntered="#onAlbumImageHover" onMouseExited="#onAlbumImageUnhover"
                   BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="albumImage" fitHeight="350.0" fitWidth="350.0" pickOnBounds="true"
                           preserveRatio="true" StackPane.alignment="TOP_CENTER">
                    <image>
                        <Image url="@/img/noimage.png"/>
                    </image>
                </ImageView>
                <ImageView fx:id="playImageButton" fitHeight="200.0" fitWidth="200.0"
                           onMouseClicked="#onPlayImageClicked" opacity="0.0" pickOnBounds="true" preserveRatio="true"
                           StackPane.alignment="CENTER">
                    <image>
                        <Image url="@/img/album-play-button.png"/>
                    </image>
                </ImageView>
            </children>
        </StackPane>
    </left>
    <center>
        <VBox fx:id="contentsVbox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
              BorderPane.alignment="TOP_LEFT">
            <children>
                <Label fx:id="albumTitle" VBox.vgrow="NEVER" styleClass="text-heading">
                </Label>
                <Label fx:id="albumDetails" layoutX="10.0" layoutY="10.0" VBox.vgrow="NEVER" styleClass="text-body">
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="album-actions" VBox.vgrow="NEVER">
                    <padding>
                        <Insets bottom="8.0" top="4.0"/>
                    </padding>
                    <children>
                        <Button mnemonicParsing="false" onAction="#onPlayButtonClicked" text="Play">
                            <graphic>
                                <FontIcon iconLiteral="mdi2p-play" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Play this album (replaces the queue)"/>
                            </tooltip>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onAddToQueueClicked" text="Add to queue">
                            <graphic>
                                <FontIcon iconLiteral="mdi2p-playlist-plus" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Add this album to the end of the queue"/>
                            </tooltip>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#onShuffleClicked" text="Shuffle">
                            <graphic>
                                <FontIcon iconLiteral="mdi2s-shuffle-variant" iconSize="16"/>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Shuffle and play this album (replaces the queue)"/>
                            </tooltip>
                        </Button>
                    </children>
                </HBox>
                <VBox fx:id="albumDiscsVbox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                      spacing="25.0" VBox.vgrow="ALWAYS"/>
            </children>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </BorderPane.margin>
        </VBox>
    </center>
</BorderPane>
